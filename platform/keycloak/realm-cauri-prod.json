    "realm": [
      {
        "name": "customer",
        "description": "Cliente final de la app móvil"
      },
      {
        "name": "merchant",
        "description": "Comercio con acceso al portal"
      },
      {
        "name": "ops",
        "description": "Operaciones, solo lectura en backoffice"
      },
      {
        "name": "ops-admin",
        "description": "Operaciones con permisos de escritura (freeze, etc)"
      },
      {
        "name": "service",
        "description": "Rol de service account para llamadas entre servicios"
      }
    ]
